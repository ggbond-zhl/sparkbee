{
  "name": "spark-bee",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "start-server-and-test \"pnpm --filter @spark-bee/server dev\" http://127.0.0.1:3000/api/ready \"pnpm --filter @spark-bee/web dev\"",
    "build": "pnpm --recursive --if-present build",
    "db:migrate": "pnpm --filter @spark-bee/server db:migrate",
    "test": "pnpm --recursive --if-present test",
    "test:unit": "pnpm --recursive --if-present test:unit",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.8",
    "start-server-and-test": "^3.0.11",
    "typescript": "^5.9.2",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@10.23.0"
}
