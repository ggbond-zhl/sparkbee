{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sparkbee-test-keepalive",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "workers_dev": false,
  "triggers": {
    "crons": ["*/14 * * * *"]
  },
  "vars": {
    "HEALTH_URL": "https://sparkbee-test-api.onrender.com/api/health"
  },
  "observability": {
    "enabled": true
  }
}
